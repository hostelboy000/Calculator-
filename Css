* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;

    font-family: Arial, Helvetica, sans-serif;

    background:
        radial-gradient(circle at 20% 20%, #6c5ce7 0%, transparent 30%),
        radial-gradient(circle at 80% 80%, #00cec9 0%, transparent 30%),
        linear-gradient(135deg, #141e30, #243b55);

    overflow: hidden;
}

/* Decorative background circles */

body::before,
body::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    z-index: -1;
}

body::before {
    width: 220px;
    height: 220px;
    background: rgba(255, 0, 150, 0.35);
    top: 10%;
    left: 15%;
}

body::after {
    width: 280px;
    height: 280px;
    background: rgba(0, 255, 200, 0.25);
    bottom: 5%;
    right: 10%;
}

/* Calculator */

.calculator {
    width: min(380px, 92vw);
    padding: 24px;

    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 30px;

    background: rgba(255, 255, 255, 0.10);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);

    box-shadow:
        0 25px 60px rgba(0, 0, 0, 0.35),
        inset 0 1px 1px rgba(255, 255, 255, 0.25);
}

/* Display */

.display {
    min-height: 120px;
    padding: 20px;
    margin-bottom: 20px;

    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;

    border-radius: 20px;

    background: rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.12);

    color: white;

    overflow: hidden;
}

.previous-operand {
    min-height: 28px;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.6);
}

.current-operand {
    width: 100%;

    font-size: clamp(32px, 9vw, 48px);
    font-weight: 600;

    text-align: right;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Buttons */

.buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.btn {
    height: 65px;

    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 18px;

    background: rgba(255, 255, 255, 0.10);

    color: white;

    font-size: 21px;
    font-weight: 500;

    cursor: pointer;

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    box-shadow:
        inset 0 1px 1px rgba(255, 255, 255, 0.12),
        0 5px 15px rgba(0, 0, 0, 0.12);

    transition:
        transform 0.15s ease,
        background 0.15s ease,
        box-shadow 0.15s ease;
}

.btn:hover {
    background: rgba(255, 255, 255, 0.20);

    transform: translateY(-2px);

    box-shadow:
        inset 0 1px 1px rgba(255, 255, 255, 0.18),
        0 8px 20px rgba(0, 0, 0, 0.18);
}

.btn:active {
    transform: scale(0.94);
}

/* Operators */

.operator {
    background: rgba(130, 100, 255, 0.28);
}

.operator:hover {
    background: rgba(130, 100, 255, 0.45);
}

/* Function buttons */

.function {
    background: rgba(255, 255, 255, 0.16);
}

.function:hover {
    background: rgba(255, 255, 255, 0.25);
}

/* Equals */

.equals {
    background: rgba(0, 220, 180, 0.35);
}

.equals:hover {
    background: rgba(0, 220, 180, 0.55);
}

/* Zero button */

.zero {
    grid-column: span 2;
}

/* Mobile */

@media (max-width: 420px) {

    .calculator {
        padding: 18px;
        border-radius: 25px;
    }

    .btn {
        height: 58px;
        border-radius: 15px;
        font-size: 19px;
    }

    .display {
        min-height: 105px;
    }

}
